{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@paw-time/insights",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://paw-time-api.vercel.app/v1/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
