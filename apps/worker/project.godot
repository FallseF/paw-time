; Engine configuration file.
config_version=5

[application]

config/name="Paw Time"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.137, 0.11, 0.2, 1)
boot_splash/image="res://assets/title/logo.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/DotGothic16-Regular.ttf"
theme/default_font_antialiasing=0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.15, 0.12, 0.16, 1)

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.ja.translation")
locale/fallback="en"
