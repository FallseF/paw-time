; Engine configuration file.
config_version=5

[application]

config/name="Paw Time"
config/use_custom_user_dir=true
config/custom_user_dir_name="obake_breakroom"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/ZenMaruGothic-Bold.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.15, 0.12, 0.16, 1)
